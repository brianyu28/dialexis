{
  "name": "dialexis",
  "version": "0.4.0",
  "description": "Presentation library built with Presenter.js",
  "main": "dist/dialexis.mjs",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/dialexis.mjs"
    },
    "./spark": {
      "types": "./dist/src/spark/index.d.ts",
      "import": "./dist/spark.mjs"
    }
  },
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "watch": "vite build --watch",
    "prettier": "prettier . --write --ignore-unknown",
    "prepare": "husky && npm run build",
    "test": "jest"
  },
  "author": "Brian Yu <brian@brianyu.me>",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/jest": "^30.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jiti": "^2.5.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^6.3.5"
  },
  "peerDependencies": {
    "presenter": "^0.7.0"
  },
  "lint-staged": {
    "**/*": [
      "prettier --ignore-unknown",
      "eslint",
      "jest --findRelatedTests --passWithNoTests"
    ]
  }
}
