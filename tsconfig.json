{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "exactOptionalPropertyTypes": true,
    "module": "node16",
    "moduleResolution": "node16",
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "./dist/",
    "resolveJsonModule": true,
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "target": "ES2022"
  },
  "exclude": ["./packages", "./dist", "./vite.config.ts", "./eslint.config.mts", "./jest.config.js"]
}
